# --- eGov SuperAgent ---
# Canonical public URL. Used for metadataBase, canonical links, OG images,
# robots.txt and sitemap.xml. Leave unset in production (it defaults to the
# live domain); Vercel preview deployments should set it to the preview URL.
# NEXT_PUBLIC_SITE_URL="https://egovsuperagent.online"

# Optional. Only needed to complete the Facebook Messenger webhook handshake at
# /api/webhook/messenger — the GET verification echoes hub.challenge when the
# token matches. Message handling itself is not wired up in this MVP.
# MESSENGER_VERIFY_TOKEN="a-long-random-string"
